{
  "expo": {
    "name": "CareBot",
    "slug": "wavixa-crm",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.wavixa.crm"
    },
    "android": {
      "package": "net.wavixa.crm",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "REQUEST_INSTALL_PACKAGES",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#00A884",
          "sounds": [
            "./assets/notify_ding.wav",
            "./assets/ringtone.wav",
            "./assets/notify_tone.wav"
          ]
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "اسمح لتطبيق CareBot بتسجيل الرسائل الصوتية وإرسالها في المحادثات."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "اسمح لتطبيق CareBot بالوصول إلى صورك وفيديوهاتك لإرسالها في المحادثات.",
          "cameraPermission": "اسمح لتطبيق CareBot باستخدام الكاميرا لالتقاط الصور والفيديو."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "اسمح لتطبيق CareBot باستخدام الكاميرا لالتقاط الصور والفيديو وإرسالها.",
          "microphonePermission": "اسمح لتطبيق CareBot بتسجيل الصوت أثناء تصوير الفيديو."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "اسمح لتطبيق CareBot بالوصول إلى صورك وفيديوهاتك لإرسالها في المحادثات.",
          "savePhotosPermission": "اسمح لتطبيق CareBot بحفظ الصور والفيديو في معرضك.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-document-picker",
      "expo-status-bar",
      "react-native-audio-api",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e26a4f27-590a-4a3d-ac8a-46b9ffbe2e43"
      }
    },
    "owner": "shaheedmhmed"
  }
}
